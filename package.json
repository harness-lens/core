{
  "name": "@harness-lens/core",
  "version": "0.0.1",
  "description": "Deterministic discovery and structural analysis for AI harness files.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/harness-lens/core.git"
  },
  "homepage": "https://github.com/harness-lens/core#readme",
  "bugs": {
    "url": "https://github.com/harness-lens/core/issues"
  },
  "keywords": [
    "agents",
    "harness",
    "instructions",
    "validation"
  ],
  "author": "Cristian Camargo Filho",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2"
  }
}
